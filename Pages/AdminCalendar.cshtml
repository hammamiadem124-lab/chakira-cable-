@page
@model HRLeaveApp.Pages.AdminCalendarModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendrier — HR Leave App</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <style>
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            margin-top: 16px;
        }
        .day-header { font-weight: 600; font-size: 12px; color: var(--text-muted); text-align: center; padding: 4px; }
        .day-cell {
            min-height: 74px;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px;
            font-size: 13px;
            cursor: default;
        }
        .day-cell.editable { cursor: pointer; }
        .day-cell.editable:hover { border-color: var(--primary); }
        .day-cell.empty { background: transparent; border: none; cursor: default; }
        .day-cell .day-num { font-weight: 600; margin-bottom: 4px; }
        .day-cell.leave { background: #fee2e2; }
        .day-cell.working { background: #dcfce7; }
        .day-cell.holiday { background: #e0e7ff; }
        .day-cell.weekend { background: #f3f4f6; }
        .nav-btns { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
        .nav-btns button { background: var(--primary); color: white; padding: 6px 14px; }
        .month-label { font-weight: 700; font-size: 16px; min-width: 160px; text-align: center; }
        .legend { display:flex; gap:16px; margin-top:14px; font-size:12px; color:var(--text-muted); }
        .legend span { display:flex; align-items:center; gap:6px; }
        .legend .dot { width:10px; height:10px; border-radius:3px; display:inline-block; }
    </style>
</head>
<body>
    <div class="navbar">
        <span class="brand"><img src="~/images/logo.jpeg" alt="Logo" style="height:28px; vertical-align:middle; margin-right:8px;" />HR Leave App</span>
        <div>
            <span class="user-info" id="userInfo"></span>
            <button onclick="goBack()" style="margin-left:12px;">Retour</button>
        </div>
    </div>

    <div class="container">
        <div class="card">
            <h2 id="calendarTitle">Calendrier</h2>
            <div class="nav-btns">
                <button onclick="changeMonth(-1)">&larr; Précédent</button>
                <span class="month-label" id="monthLabel"></span>
                <button onclick="changeMonth(1)">Suivant &rarr;</button>
            </div>
            <div class="calendar-grid" id="calendarGrid"></div>
            <div class="legend">
                <span><i class="dot" style="background:#dcfce7;"></i> Travail</span>
                <span><i class="dot" style="background:#fee2e2;"></i> Congé</span>
                <span><i class="dot" style="background:#e0e7ff;"></i> Jour férié</span>
                <span><i class="dot" style="background:#f3f4f6;"></i> Week-end / repos</span>
            </div>
            <p id="editHint" style="display:none; color:var(--text-muted); font-size:13px; margin-top:10px;">
                💡 Clique sur un jour pour modifier le planning de cet employé.
            </p>
        </div>
    </div>

    <!-- Modal : modifier le planning d'un jour (admin uniquement) -->
    <div class="modal-overlay" id="dayModal">
        <div class="modal-box">
            <h3 id="dayModalTitle">Modifier le jour</h3>
            <div id="dayModalError" class="error-msg"></div>
            <form id="dayForm">
                <div class="form-group">
                    <label for="dayStatus">Statut</label>
                    <select id="dayStatus">
                        <option value="Working">Travail</option>
                        <option value="Holiday">Jour férié</option>
                        <option value="Weekend">Week-end / repos</option>
                    </select>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                    <div class="form-group">
                        <label for="dayShiftStart">Début (optionnel)</label>
                        <input type="time" id="dayShiftStart" />
                    </div>
                    <div class="form-group">
                        <label for="dayShiftEnd">Fin (optionnel)</label>
                        <input type="time" id="dayShiftEnd" />
                    </div>
                </div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="btn-primary">Enregistrer</button>
                    <button type="button" onclick="closeDayModal()" style="background:var(--border);">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = sessionStorage.getItem('hr_token');
        const employee = JSON.parse(sessionStorage.getItem('hr_employee') || 'null');

        if (!token || !employee) {
            window.location.href = '/Login';
        }

        document.getElementById('userInfo').textContent = `${employee.firstName} ${employee.lastName}`;

        function goBack() {
            window.location.href = employee.role === 'Admin' ? '/AdminLeaveRequests' : '/EmployeeDashboard';
        }

        const urlParams = new URLSearchParams(window.location.search);
        const targetEmployeeId = urlParams.get('employeeId');
        const targetName = urlParams.get('name');
        const isAdminEditing = employee.role === 'Admin' && !!targetEmployeeId;

        document.getElementById('calendarTitle').textContent = targetName
            ? `Calendrier de ${targetName}`
            : 'Mon calendrier';

        if (isAdminEditing) {
            document.getElementById('editHint').style.display = 'block';
        }

        let currentDate = new Date();

        const dayNames = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
        const monthNames = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];

        function changeMonth(delta) {
            currentDate.setMonth(currentDate.getMonth() + delta);
            loadCalendar();
        }

        async function loadCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth() + 1;
            document.getElementById('monthLabel').textContent = `${monthNames[month - 1]} ${year}`;

            const url = targetEmployeeId
                ? `/api/Schedule/employee/${targetEmployeeId}?year=${year}&month=${month}`
                : `/api/Schedule/mine?year=${year}&month=${month}`;

            let data = { schedule: [], leaves: [] };
            try {
                const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
                if (res.status === 401 || res.status === 403) { window.location.href = '/Login'; return; }
                data = await res.json();
            } catch (err) {
                // Garde le calendrier vide en cas d'erreur réseau
            }

            renderCalendar(year, month, data.schedule || [], data.leaves || []);
        }

        function isDateInLeave(date, leaves) {
            return leaves.some(l => {
                const start = new Date(l.startDate);
                const end = new Date(l.endDate);
                return date >= new Date(start.toDateString()) && date <= new Date(end.toDateString());
            });
        }

        function renderCalendar(year, month, schedule, leaves) {
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            dayNames.forEach(d => {
                const header = document.createElement('div');
                header.className = 'day-header';
                header.textContent = d;
                grid.appendChild(header);
            });

            const firstDay = new Date(year, month - 1, 1);
            let startOffset = (firstDay.getDay() + 6) % 7; // lundi = 0
            const daysInMonth = new Date(year, month, 0).getDate();

            for (let i = 0; i < startOffset; i++) {
                const empty = document.createElement('div');
                empty.className = 'day-cell empty';
                grid.appendChild(empty);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const date = new Date(year, month - 1, day);
                const cell = document.createElement('div');
                cell.className = 'day-cell';
                if (isAdminEditing) cell.classList.add('editable');

                const onLeave = isDateInLeave(date, leaves);
                const scheduleEntry = schedule.find(s => new Date(s.workDate).getDate() === day);

                if (onLeave) {
                    cell.classList.add('leave');
                } else if (scheduleEntry) {
                    cell.classList.add(scheduleEntry.status.toLowerCase());
                }

                let label = '';
                if (onLeave) label = 'Congé';
                else if (scheduleEntry) {
                    const labels = { Working: 'Travail', Holiday: 'Férié', Weekend: 'Repos' };
                    label = labels[scheduleEntry.status] || scheduleEntry.status;
                    if (scheduleEntry.shiftStart) label += `<br><small>${scheduleEntry.shiftStart.substring(0,5)}-${(scheduleEntry.shiftEnd || '').substring(0,5)}</small>`;
                }

                cell.innerHTML = `<div class="day-num">${day}</div><div>${label}</div>`;

                if (isAdminEditing && !onLeave) {
                    cell.addEventListener('click', () => openDayModal(date, scheduleEntry));
                }

                grid.appendChild(cell);
            }
        }

        let selectedDate = null;

        function openDayModal(date, existingEntry) {
            selectedDate = date;
            document.getElementById('dayModalTitle').textContent =
                `Modifier le ${date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}`;
            document.getElementById('dayModalError').style.display = 'none';

            document.getElementById('dayStatus').value = existingEntry ? existingEntry.status : 'Working';
            document.getElementById('dayShiftStart').value = existingEntry && existingEntry.shiftStart ? existingEntry.shiftStart.substring(0,5) : '';
            document.getElementById('dayShiftEnd').value = existingEntry && existingEntry.shiftEnd ? existingEntry.shiftEnd.substring(0,5) : '';

            document.getElementById('dayModal').classList.add('open');
        }

        function closeDayModal() {
            document.getElementById('dayModal').classList.remove('open');
        }

        document.getElementById('dayForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const errorDiv = document.getElementById('dayModalError');
            errorDiv.style.display = 'none';

            const body = {
                employeeId: parseInt(targetEmployeeId),
                workDate: selectedDate.toISOString().split('T')[0],
                shiftStart: document.getElementById('dayShiftStart').value || null,
                shiftEnd: document.getElementById('dayShiftEnd').value || null,
                status: document.getElementById('dayStatus').value
            };

            try {
                const res = await fetch('/api/Schedule', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(body)
                });

                if (!res.ok) {
                    errorDiv.textContent = "Erreur lors de l'enregistrement.";
                    errorDiv.style.display = 'block';
                    return;
                }

                closeDayModal();
                loadCalendar();
            } catch (err) {
                errorDiv.textContent = 'Impossible de contacter le serveur.';
                errorDiv.style.display = 'block';
            }
        });

        loadCalendar();
    </script>
</body>
</html>
