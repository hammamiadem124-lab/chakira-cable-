@page
@model HRLeaveApp.Pages.AdminAnnouncementsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Annonces — HR Leave App</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="navbar">
        <span class="brand"><img src="~/images/logo.jpeg" alt="Logo" style="height:28px; vertical-align:middle; margin-right:8px;" />HR Leave App — Admin</span>
        <div>
            <span class="user-info" id="userInfo"></span>
            <button onclick="logout()" style="margin-left:12px;">Déconnexion</button>
        </div>
    </div>

    <div class="admin-layout">
        <div class="sidebar">
            <a href="/AdminAddEmployee">➕ Ajouter un employé</a>
            <a href="/AdminEmployeesList">👥 Liste des employés</a>
            <a href="/AdminLeaveRequests">📋 Demandes de congé</a>
            <a href="/AdminAnnouncements" class="active">📢 Annonces</a>
        </div>

        <div class="admin-content">
            <div class="card" style="max-width:600px;">
                <h2>Publier une annonce</h2>
                <div id="createError" class="error-msg"></div>
                <form id="announcementForm">
                    <div class="form-group">
                        <label for="annTitle">Titre</label>
                        <input type="text" id="annTitle" required placeholder="Ex : Pont du 1er mai" />
                    </div>
                    <div class="form-group">
                        <label for="annMessage">Message</label>
                        <textarea id="annMessage" rows="3" required placeholder="Détails de l'annonce..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="annExpiry">Date d'expiration (optionnel)</label>
                        <input type="date" id="annExpiry" />
                    </div>
                    <button type="submit" class="btn-primary">Publier</button>
                </form>
            </div>

            <div class="card">
                <h2>Annonces actives</h2>
                <div id="announcementsList">Chargement...</div>
            </div>
        </div>
    </div>

    <script>
        const token = sessionStorage.getItem('hr_token');
        const employee = JSON.parse(sessionStorage.getItem('hr_employee') || 'null');

        if (!token || !employee || employee.role !== 'Admin') {
            window.location.href = '/Login';
        }

        document.getElementById('userInfo').textContent = `${employee.firstName} ${employee.lastName} (Admin)`;

        function logout() {
            sessionStorage.removeItem('hr_token');
            sessionStorage.removeItem('hr_employee');
            window.location.href = '/Login';
        }

        async function loadAnnouncements() {
            const list = document.getElementById('announcementsList');
            try {
                const res = await fetch('/api/Announcement', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await res.json();

                if (data.length === 0) {
                    list.innerHTML = '<p style="color:var(--text-muted); font-size:14px;">Aucune annonce active.</p>';
                    return;
                }

                list.innerHTML = data.map(a => `
                    <div class="card" style="margin-bottom:10px; padding:14px;">
                        <div style="display:flex; justify-content:space-between; align-items:start;">
                            <div>
                                <strong>${a.title}</strong>
                                <p style="margin:6px 0 0; font-size:13px; color:var(--text-muted);">${a.message}</p>
                                <p style="margin:6px 0 0; font-size:11px; color:var(--text-muted);">Publié le ${new Date(a.createdAt).toLocaleDateString('fr-FR')}${a.expiresAt ? ' · Expire le ' + new Date(a.expiresAt).toLocaleDateString('fr-FR') : ''}</p>
                            </div>
                            <button class="btn-danger-outline" onclick="deleteAnnouncement(${a.announcementId})">🗑️</button>
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                list.innerHTML = '<p>Erreur de chargement.</p>';
            }
        }

        document.getElementById('announcementForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const errorDiv = document.getElementById('createError');
            errorDiv.style.display = 'none';

            const expiry = document.getElementById('annExpiry').value;
            const body = {
                title: document.getElementById('annTitle').value,
                message: document.getElementById('annMessage').value,
                expiresAt: expiry ? new Date(expiry).toISOString() : null
            };

            try {
                const res = await fetch('/api/Announcement', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(body)
                });

                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    errorDiv.textContent = data.message || "Erreur lors de la publication.";
                    errorDiv.style.display = 'block';
                    return;
                }

                document.getElementById('announcementForm').reset();
                loadAnnouncements();
            } catch (err) {
                errorDiv.textContent = 'Impossible de contacter le serveur.';
                errorDiv.style.display = 'block';
            }
        });

        async function deleteAnnouncement(id) {
            if (!confirm('Supprimer cette annonce ?')) return;
            try {
                const res = await fetch(`/api/Announcement/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) loadAnnouncements();
            } catch (err) {
                alert('Impossible de contacter le serveur.');
            }
        }

        loadAnnouncements();
    </script>
</body>
</html>
